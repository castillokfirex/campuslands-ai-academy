# =========================================================
# Campuslands AI Academy - Variables de Entorno (Plantilla)
# Copia este archivo a .env.local y configura tus valores.
# NUNCA subas credenciales reales a Git ni al repositorio.
# =========================================================

# Base de datos PostgreSQL (Neon, Supabase o Postgres local).
# Si se deja vacío, la app usa SQLite local automáticamente (data/leads.sqlite).
DATABASE_URL=

# Acceso al Panel de Administración (/admin)
ADMIN_EMAIL=admin@aiacademy.local
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_SEGURA
ADMIN_NAME=Kevin Castillo

# Segundo administrador opcional (para demostrar trazabilidad multiusuario)
ADMIN_SECONDARY_EMAIL=andres.admin@aiacademy.local
ADMIN_SECONDARY_PASSWORD=CAMBIA_ESTA_CLAVE_SEGURA_2
ADMIN_SECONDARY_NAME=Andrés Evaluador

# Secreto para firmar cookies de sesión (mínimo 32 caracteres aleatorios)
SESSION_SECRET=reemplaza_con_una_cadena_aleatoria_de_al_menos_32_caracteres

# Webhook de n8n que envía la notificación a Telegram
# Ejemplo local: http://localhost:5678/webhook/ai-academy-registro
N8N_WEBHOOK_URL=

# Token secreto opcional enviado en cabecera X-Webhook-Secret hacia n8n
N8N_WEBHOOK_SECRET=
